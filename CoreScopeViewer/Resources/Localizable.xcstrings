          }
        }
      }
    },
    "Companions are only heard when they send something, so a quiet spell is normal." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los acompañantes solo se escuchan cuando envían algo, así que un periodo de silencio es normal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os companheiros só são ouvidos quando enviam algo, então um período de silêncio é normal."
          }
        }
      }
    },
    "Compares saved nodes and observers using the 15-minute recently-heard window. Silence does not mean offline." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara los nodos y observadores guardados usando la ventana de 15 minutos de escuchados recientemente. El silencio no significa que esté desconectado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara os nós e observadores salvos usando a janela de 15 minutos de ouvidos recentemente. Silêncio não significa offline."
          }
        }
      }
    },
    "Comparison data was cleared or the source changed. Reopen Changes to continue." : {
      "localizations" : {
