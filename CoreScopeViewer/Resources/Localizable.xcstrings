            "value" : "Importarlos solo como datos de entrada"
          }
        }
      }
    },
    "Imported items are added as copies. Nothing in your library is replaced, and nothing is calculated." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos importados se agregan como copias. No se reemplaza nada de tu biblioteca y no se calcula nada."
