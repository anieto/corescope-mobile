    "The strongest is %@%@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The strongest is %1$@%2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El más fuerte es %1$@%2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mais forte é %1$@%2$@."
          }
        }
      }
    },
    "The study exhausted its work budget. Some samples were not calculated. Try a smaller radius or wider sample spacing." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El estudio agotó su presupuesto de trabajo. Algunas muestras no se calcularon. Prueba con un radio menor o un espaciado de muestras mayor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O estudo esgotou o orçamento de trabalho. Algumas amostras não foram calculadas. Tente um raio menor ou um espaçamento de amostras maior."
          }
        }
      }
    },
    "The study you opened was deleted. This saves it as a new study." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El estudio que abriste se eliminó. Esto lo guarda como un estudio nuevo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O estudo que você abriu foi excluído. Isto o salva como um estudo novo."
          }
        }
      }
    },
    "The time it was sent is unknown." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se sabe cuándo se envió."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não se sabe quando foi enviado."
          }
        }
      }
    },
    "There isn’t enough storage to save this result. Your previous save is unchanged. Remove an older study, or save inputs only." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay suficiente almacenamiento para guardar este resultado. Lo guardado anteriormente no cambió. Quita un estudio más antiguo o guarda solo los datos de entrada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há armazenamento suficiente para salvar este resultado. O que foi salvo antes não mudou. Remova um estudo mais antigo ou salve só os dados de entrada."
          }
        }
      }
    },
    "There isn't room for these results. Choose fewer items, or import inputs only." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay espacio para estos resultados. Elige menos elementos o importa solo los datos de entrada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há espaço para estes resultados. Escolha menos itens ou importe só os dados de entrada."
          }
        }
      }
    },
    "These details come from community reports on this CoreScope analyzer. A claim means someone says they operate the repeater. Reported status reflects what someone entered. Last heard reflects activity the analyzer observed." : {
      "comment" : "A description of the information displayed in the `RepeaterMetadataCard`.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos detalles provienen de informes de la comunidad en este analizador de CoreScope. Una reclamación indica que alguien afirma operar el repetidor. El estado reportado refleja lo que alguien ingresó. La última vez que se oyó el nodo refleja la actividad observada por el analizador."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esses detalhes vêm de informações da comunidade neste analisador do CoreScope. Uma reivindicação indica que alguém afirma operar o repetidor. O estado informado reflete o que alguém registrou. O horário em que o nó foi ouvido pela última vez reflete a atividade observada pelo analisador."
          }
        }
      }
    },
    "These studies are left out unless you import their inputs only." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos estudios se omiten a menos que importes solo sus datos de entrada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes estudos ficam de fora, a menos que você importe só os dados de entrada deles."
          }
        }
      }
    },
    "These unfinished studies couldn't be saved on this device: %@. Switching analyzer now loses their latest changes. Saved plans aren't affected." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos estudios sin terminar no se pudieron guardar en este dispositivo: %@. Si cambias de analizador ahora, se perderán sus últimos cambios. Los planes guardados no se ven afectados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes estudos não concluídos não puderam ser salvos neste dispositivo: %@. Trocar de analisador agora perde as alterações mais recentes deles. Os planos salvos não são afetados."
          }
        }
      }
    },
    "This account reached its watch limit. Stop watching a node before adding another." : {
      "comment" : "Error message displayed when a user tries to add a new node to their account favorites but has reached the limit.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cuenta alcanzó el límite de nodos seguidos. Deja de seguir un nodo antes de agregar otro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conta atingiu o limite de nós monitorados. Pare de monitorar um nó antes de adicionar outro."
          }
        }
      }
    },
    "This adds device node favorites to this account’s pending selections. Choose Sync now to upload. Observer and channel favorites stay local." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto agrega los nodos favoritos del dispositivo a las selecciones pendientes de esta cuenta. Elige Sincronizar ahora para subirlas. Los favoritos de observadores y canales se quedan en el dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto adiciona os nós favoritos do dispositivo às seleções pendentes desta conta. Escolha Sincronizar agora para enviá-las. Os favoritos de observadores e canais ficam no dispositivo."
          }
        }
      }
    },
    "This alert can no longer be opened." : {
      "comment" : "A description of the alert that appears when the user opens a Staging Push notification that has already been dismissed.",
