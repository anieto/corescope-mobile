    "Doubling the radius roughly quadruples the map samples at the same spacing. Longer paths also take more work." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duplicar el radio multiplica aproximadamente por cuatro las muestras del mapa con el mismo espaciado. Los trayectos más largos también requieren más trabajo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobrar o raio quadruplica aproximadamente as amostras do mapa com o mesmo espaçamento. Trajetos mais longos também dão mais trabalho."
          }
        }
      }
    },
    "Downloaded account selections and pending account edits will be removed from this device. Existing device favorites are preserved." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las selecciones de la cuenta descargadas y los cambios pendientes de la cuenta se quitarán de este dispositivo. Los favoritos del dispositivo se conservan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As seleções da conta baixadas e as alterações pendentes da conta serão removidas deste dispositivo. Os favoritos do dispositivo são mantidos."
          }
        }
      }
    },
    "Downloaded analyzer responses and Favorites activity comparison snapshots will be removed. Favorites, monitored channels and keys, recent items, appearance, and analyzer settings will be kept." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quitarán las respuestas descargadas del analizador y las instantáneas de comparación de actividad de Favoritos. Se conservarán los favoritos, los canales monitoreados y sus claves, los elementos recientes, la apariencia y la configuración del analizador."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As respostas baixadas do analisador e os instantâneos de comparação de atividade dos Favoritos serão removidos. Os favoritos, os canais monitorados e suas chaves, os itens recentes, a aparência e as configurações do analisador serão mantidos."
          }
        }
      }
    },
    "Downloaded data" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datos descargados"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
