    "Closest first; Direct means no repeater in between." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los más cercanos primero; Directo significa que no hay ningún repetidor en medio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os mais próximos primeiro; Direto significa que não há repetidor no meio."
