    "Plan, %@, %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Plan, %1$@, %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan, %1$@, %2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plano, %1$@, %2$@"
          }
        }
      }
    },
    "Planner results are estimates based on terrain data and the assumptions you enter. Buildings, vegetation, interference, hardware variation, and weather can change real-world performance." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los resultados del planificador son estimaciones basadas en datos del terreno y en los supuestos que ingreses. Los edificios, la vegetación, las interferencias, las diferencias de hardware y el clima pueden cambiar el rendimiento real."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os resultados do planejador são estimativas baseadas nos dados do terreno e nas premissas que você insere. Prédios, vegetação, interferência, variações de hardware e o clima podem mudar o desempenho real."
          }
        }
      }
    },
    "Planning estimates only: terrain does not account for buildings, foliage or interference. Placing points sends their coordinates to Open-Meteo for elevation; results are cached on this device." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo son estimaciones de planificación: el terreno no considera edificios, follaje ni interferencias. Al colocar puntos, sus coordenadas se envían a Open-Meteo para obtener la elevación; los resultados se guardan en caché en este dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só estimativas de planejamento: o terreno não considera prédios, folhagem nem interferência. Ao posicionar pontos, as coordenadas são enviadas ao Open-Meteo para obter a elevação; os resultados ficam em cache neste dispositivo."
          }
        }
      }
    },
    "Planning estimates only: terrain does not account for buildings, foliage or interference. Terrain is downloaded from AWS Skadi and cached on this device. Use Save to keep this setup before leaving the tool." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo son estimaciones de planificación: el terreno no considera edificios, follaje ni interferencias. El terreno se descarga de AWS Skadi y se guarda en caché en este dispositivo. Usa Guardar para conservar esta configuración antes de salir de la herramienta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só estimativas de planejamento: o terreno não considera prédios, folhagem nem interferência. O terreno é baixado do AWS Skadi e fica em cache neste dispositivo. Use Salvar para guardar esta configuração antes de sair da ferramenta."
          }
        }
      }
    },
