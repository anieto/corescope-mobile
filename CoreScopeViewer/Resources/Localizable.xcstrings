    },
    "The saved calculation could not be restored. Your inputs are available; calculate again to replace the result." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo restaurar el cálculo guardado. Tus datos de entrada están disponibles; calcula de nuevo para reemplazar el resultado."
          }
        }
      }
    },
    "The saved result can't be shown on this device and doesn't match the changed inputs. Confirm saving inputs only, or save as new." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El resultado guardado no se puede mostrar en este dispositivo y no coincide con los datos modificados. Confirma que quieres guardar solo los datos de entrada, o guarda como nuevo."
          }
        }
      }
    },
    "The saved result can't be shown on this device and doesn't match the changed inputs. Updating keeps the new inputs without a result; calculate again to get one. To keep the original and its result, choose Save as new." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El resultado guardado no se puede mostrar en este dispositivo y no coincide con los datos modificados. Al actualizar se conservan los nuevos datos sin resultado; calcula de nuevo para obtener uno. Para conservar el original y su resultado, elige Guardar como nuevo."
          }
        }
      }
    },
    "The saved result could not be verified, so it isn't shown. Your inputs are available; calculate to see results." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo verificar el resultado guardado, así que no se muestra. Tus datos de entrada están disponibles; calcula para ver los resultados."
