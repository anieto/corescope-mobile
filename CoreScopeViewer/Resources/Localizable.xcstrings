    "Creates %lld plans with %lld Coverage studies, using Coverage's defaults for the receiver and study area. Nothing is calculated. Candidate Sites is then removed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creates %#@plans@ with %#@studies@, using Coverage's defaults for the receiver and study area. Nothing is calculated. Candidate Sites is then removed."
          },
          "substitutions" : {
            "plans" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg plan"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg plans"
                    }
                  }
                }
              }
            },
            "studies" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg Coverage study"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg Coverage studies"
                    }
                  }
                }
              }
            }
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea %#@plans@ con %#@studies@, usando los valores predeterminados de Cobertura para el receptor y el área de estudio. No se calcula nada. Después se elimina Sitios candidatos."
          },
          "substitutions" : {
            "plans" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
