    "NodeScope derives the public hashtag key and decrypts matching traffic locally." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NodeScope deriva la clave pública del hashtag y descifra en el dispositivo el tráfico que coincide."
          }
