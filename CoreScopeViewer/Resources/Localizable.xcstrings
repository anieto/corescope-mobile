    "Beacon" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beacon"
          }
        }
      }
    },
    "Beacon %@ is not supported. Version 2.0.3 or newer is required." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beacon %@ no es compatible. Se requiere la versión 2.0.3 o posterior."
          }
        }
      }
    },
    "Beacon Support" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatibilidad con Beacon"
          }
        }
      }
    },
    "Beacon adds nodes as it hears their advertisements. Some repeaters advertise only every 12–47 hours, so a quiet region can take time to fill in." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beacon agrega nodos a medida que escucha sus adverts. Algunos repetidores solo envían adverts cada 12–47 horas, así que una región tranquila puede tardar en llenarse."
          }
        }
      }
    },
    "Beacon could not be rechecked. The selected server type is unchanged." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo volver a comprobar Beacon. El tipo de servidor seleccionado no cambió."
          }
        }
      }
    },
    "Beacon does not provide map defaults; NodeScope uses region coordinates." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beacon no ofrece valores predeterminados del mapa; NodeScope usa las coordenadas de la región."
          }
        }
      }
    },
    "Beacon has not recorded any neighboring nodes for this node yet." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beacon aún no ha registrado nodos vecinos para este nodo."
          }
        }
      }
    },
    "Beacon node history does not identify observers or peers, so observer coverage, peer interactions, availability, longest silence, and signal grade cannot be calculated reliably." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial de nodos de Beacon no identifica observadores ni pares, así que no se pueden calcular de forma confiable la cobertura de observadores, las interacciones con pares, la disponibilidad, el silencio más largo ni la calificación de señal."
          }
        }
      }
    },
    "Beacon provides up to 30 days of hourly activity. Packet types and hops cover the last seven days." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beacon ofrece hasta 30 días de actividad por hora. Los tipos de paquete y los saltos cubren los últimos siete días."
          }
        }
      }
    },
    "Beacon reports nearby nodes, but not link direction or observer coverage." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beacon informa nodos cercanos, pero no la dirección del enlace ni la cobertura de observadores."
          }
        }
      }
    },
    "Beacon reports observer activity as observations. Unique-node history, recent packet rows, and a true SNR distribution aren’t available from this endpoint." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beacon informa la actividad de los observadores como observaciones. Este endpoint no ofrece historial de nodos únicos, filas de paquetes recientes ni una distribución real de SNR."
          }
        }
      }
    },
    "Beacon responded over HTTPS." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beacon respondió por HTTPS."
          }
        }
      }
    },
    "Beacon retains up to seven days of observation history." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beacon conserva hasta siete días de historial de observaciones."
          }
        }
      }
    },
