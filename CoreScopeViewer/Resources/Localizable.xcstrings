        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A compra está aguardando aprovação."
          }
        }
      }
    },
    "The request was rejected. Check your credentials or try again later." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se rechazó la solicitud. Revisa tus credenciales o inténtalo más tarde."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A solicitação foi recusada. Verifique suas credenciais ou tente mais tarde."
          }
        }
      }
    },
    "The requested history exceeds the page budget. Try a smaller window." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial solicitado supera el límite de páginas. Prueba con un periodo más corto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O histórico solicitado excede o limite de páginas. Tente um período menor."
          }
        }
      }
    },
    "The result could not be drawn. Calculate again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo dibujar el resultado. Calcula de nuevo."
          }
