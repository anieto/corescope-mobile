    "Beacon %@ is not supported. Version 2.0.3 or newer is required." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beacon %@ no es compatible. Se requiere la versión 2.0.3 o posterior."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Beacon %@ não é compatível. É necessária a versão 2.0.3 ou mais recente."
          }
        }
      }
    },
    "Beacon adds nodes as it hears their advertisements. Some repeaters advertise only every 12–47 hours, so a quiet region can take time to fill in." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beacon agrega nodos a medida que escucha sus anuncios. Algunos repetidores solo envían anuncios cada 12–47 horas, así que una región tranquila puede tardar en llenarse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Beacon adiciona nós conforme ouve os anúncios deles. Alguns repetidores só enviam anúncios a cada 12–47 horas, então uma região tranquila pode demorar para se preencher."
          }
        }
      }
    },
    "Beacon could not be rechecked. The selected server type is unchanged." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo volver a comprobar Beacon. El tipo de servidor seleccionado no cambió."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar o Beacon de novo. O tipo de servidor selecionado não mudou."
          }
        }
      }
    },
    "Beacon does not provide map defaults; NodeScope uses region coordinates." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beacon no ofrece valores predeterminados del mapa; NodeScope usa las coordenadas de la región."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Beacon não fornece padrões de mapa; o NodeScope usa as coordenadas da região."
          }
        }
      }
    },
    "Beacon has not recorded any neighboring nodes for this node yet." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beacon aún no ha registrado nodos vecinos para este nodo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Beacon ainda não registrou nós vizinhos para este nó."
          }
        }
      }
    },
    "Beacon node history does not identify observers or peers, so observer coverage, peer interactions, availability, longest silence, and signal grade cannot be calculated reliably." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial de nodos de Beacon no identifica observadores ni pares, así que no se pueden calcular de forma confiable la cobertura de observadores, las interacciones con pares, la disponibilidad, el silencio más largo ni la calificación de señal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O histórico de nós do Beacon não identifica observadores nem pares, então a cobertura de observadores, as interações com pares, a disponibilidade, o maior silêncio e a nota de sinal não podem ser calculados de forma confiável."
          }
        }
      }
    },
    "Beacon provides up to 30 days of hourly activity. Packet types and hops cover the last seven days." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beacon ofrece hasta 30 días de actividad por hora. Los tipos de paquete y los saltos cubren los últimos siete días."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Beacon fornece até 30 dias de atividade por hora. Os tipos de pacote e os saltos cobrem os últimos sete dias."
          }
        }
      }
    },
    "Beacon reports nearby nodes, but not link direction or observer coverage." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beacon informa nodos cercanos, pero no la dirección del enlace ni la cobertura de observadores."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Beacon informa nós próximos, mas não a direção do enlace nem a cobertura de observadores."
          }
        }
      }
    },
    "Beacon reports observer activity as observations. Unique-node history, recent packet rows, and a true SNR distribution aren’t available from this endpoint." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beacon informa la actividad de los observadores como observaciones. Este endpoint no ofrece historial de nodos únicos, filas de paquetes recientes ni una distribución real de SNR."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Beacon informa a atividade dos observadores como observações. Este endpoint não fornece histórico de nós únicos, linhas de pacotes recentes nem uma distribuição real de SNR."
          }
        }
      }
    },
