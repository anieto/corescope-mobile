      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beacon devolvió el estado %lld."
          }
        }
      }
    },
    "Beacon servers don’t provide map defaults. NodeScope uses region coordinates to frame the map instead." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servidores Beacon no ofrecen valores predeterminados del mapa. NodeScope usa las coordenadas de la región para encuadrar el mapa."
          }
        }
      }
    },
    "Beacon version and bounded browse-family checks completed." : {
      "localizations" : {
        "es" : {
