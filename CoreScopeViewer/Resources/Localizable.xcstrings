    "Beta" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta"
          }
        }
      }
    },
    "Beta estimate: terrain-only, inland paths, vertical polarization and median atmosphere. No building or tree clutter model; terrain surfaces may still contain vegetation. Not suitable for coastal or sea paths without a different model configuration." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimación beta: solo terreno, trayectos tierra adentro, polarización vertical y atmósfera media. No hay modelo de edificios ni árboles; las superficies del terreno aún pueden incluir vegetación. No es adecuado para trayectos costeros o sobre el mar sin otra configuración del modelo."
          }
        }
      }
    },
