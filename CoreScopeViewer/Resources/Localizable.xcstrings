      }
    },
    "Saved plans could not be opened. Your files have not been changed. Try again when storage is available." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron abrir los planes guardados. Tus archivos no cambiaron. Inténtalo de nuevo cuando el almacenamiento esté disponible."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível abrir os planos salvos. Seus arquivos não foram alterados. Tente de novo quando o armazenamento estiver disponível."
          }
        }
      }
    },
    "Saved plans, studies and their results are never removed here. They're included in iCloud Backup and computer backups when those are turned on. Changes you haven't saved aren't backed up.%@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los planes guardados, los estudios y sus resultados nunca se quitan aquí. Se incluyen en los respaldos de iCloud y de la computadora cuando están activados. Los cambios que no has guardado no se respaldan.%@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planos salvos, estudos e seus resultados nunca são removidos aqui. Eles entram nos backups do iCloud e do computador quando estão ativados. Alterações que você não salvou não entram no backup.%@"
          }
        }
      }
    },
