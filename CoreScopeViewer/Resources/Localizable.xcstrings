    "Green does not mean reachable. This is a one-way terrain prediction, not a test of packet delivery, return-link strength, modem compatibility or interference." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verde no significa alcanzable. Es una predicción del terreno en un solo sentido, no una prueba de entrega de paquetes, de la intensidad del enlace de regreso, de compatibilidad de módem ni de interferencias."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verde não significa alcançável. É uma previsão do terreno em um só sentido, não um teste de entrega de pacotes, da força do enlace de volta, de compatibilidade de modem nem de interferência."
          }
        }
      }
    },
