      }
    },
    "Collapsed" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contraído"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recolhido"
          }
        }
      }
    },
    "Collect a packet's reports from different observers for a few seconds, then animate its paths together. Runs slightly behind live; the analyzer sets the delay." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reúne durante unos segundos los reportes de un paquete desde distintos observadores y luego anima sus rutas juntas. Va un poco detrás del tiempo real; el analizador define el retraso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reúne por alguns segundos os relatos de um pacote vindos de diferentes observadores e depois anima as rotas juntas. Fica um pouco atrás do tempo real; o analisador define o atraso."
          }
        }
      }
    },
    "Colors match the dots on the map." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los colores coinciden con los puntos del mapa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cores correspondem aos pontos do mapa."
          }
        }
      }
    },
    "Colors show predicted margin, not guaranteed connectivity. Hatched areas have no prediction." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los colores muestran el margen previsto, no una conectividad garantizada. Las áreas rayadas no tienen predicción."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cores mostram a margem prevista, não uma conectividade garantida. Áreas hachuradas não têm previsão."
          }
        }
      }
    },
    "Combine close nodes into numbered bubbles when zoomed out. On a large mesh, turning this off can make the map lag when you pan or tap a node." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combina los nodos cercanos en burbujas numeradas al alejar el mapa. En una red mesh grande, desactivarlo puede hacer que el mapa se trabe al desplazarte o tocar un nodo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Junta nós próximos em bolhas numeradas ao afastar o mapa. Em uma rede mesh grande, desativar isso pode deixar o mapa lento ao arrastar ou tocar em um nó."
          }
        }
      }
    },
    "Coming Soon" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próximamente"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em breve"
          }
        }
      }
