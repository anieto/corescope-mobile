    "Open the transmitter, radio and receiver sections. Set antenna heights above ground and choose the radio preset used by your mesh." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre las secciones de transmisor, radio y receptor. Define la altura de las antenas sobre el suelo y elige el preset de radio que usa tu red mesh."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra as seções de transmissor, rádio e receptor. Defina a altura das antenas acima do solo e escolha o preset de rádio usado pela sua rede mesh."
          }
        }
      }
