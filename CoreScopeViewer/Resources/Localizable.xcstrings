    "Minimum work fits one batch; complex terrain can require more. Each Continue action gets a new bounded work budget without recalculating completed samples." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El trabajo mínimo cabe en una tanda; el terreno complejo puede requerir más. Cada vez que eliges Continuar se asigna un nuevo presupuesto de trabajo limitado, sin volver a calcular las muestras ya completadas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O trabalho mínimo cabe em um lote; terrenos complexos podem exigir mais. Cada vez que você escolhe Continuar, recebe um novo orçamento de trabalho limitado, sem recalcular as amostras já concluídas."
          }
        }
      }
